# Salin ke .env kalau menjalankan secara lokal (bukan lewat Coolify).
# Di Coolify, isi variable ini lewat menu Environment Variables, JANGAN commit file .env asli ke Git.

# PIN untuk membuka /admin.html dan /draw.html
ADMIN_PIN=778899

# Port di dalam container (biasanya tidak perlu diubah, Coolify akan proxy ke sini)
PORT=3000

# Folder penyimpanan database SQLite. Di Coolify arahkan ke path yang di-mount
# sebagai volume persisten, misal /app/data (sudah default di Dockerfile).
DATA_DIR=/app/data
